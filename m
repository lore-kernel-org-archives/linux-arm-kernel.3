> +#define write_sysreg_hcr(__val) do {					\
> +	if(IS_ENABLED(CONFIG_AMPERE_ERRATUM_AC04_CPU_23) &&		\
> +	   alternative_has_cap_unlikely(ARM64_WORKAROUND_AMPERE_AC04_CPU_23)) \
> +		asm volatile("dsb nsh; msr hcr_el2, %x0; isb"		\
> +			     : : "rZ" (__val));				\
